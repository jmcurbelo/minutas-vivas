# Copia este archivo como .env y ajusta los valores.
# Base de datos: hoy SQLite local; mañana Azure SQL cambiando solo esta línea.
DATABASE_URL=sqlite:///minutas.db
# Clave para firmar la cookie de sesión. En producción, un valor largo y secreto.
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
# Correo: Mailpit en local. Para correo real, cambia estos valores.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Minutas Vivas <no-responder@minutas.local>
